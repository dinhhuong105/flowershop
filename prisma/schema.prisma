generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CartStatus {
  ACTIVE
  CONVERTED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  DELIVERING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum DeliveryMethod {
  EXPRESS_2H
  SAME_DAY
  SCHEDULED
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  // SEO riêng (Ngày 14 D1): rỗng = dùng tên/mô tả mặc định như trước.
  seoTitle       String   @default("")
  seoDescription String   @default("")
  // Nguồn dữ liệu (Ngày 17 P1): seed mẫu / nhập tay / nhập file.
  // Dữ liệu cũ nhận mặc định 'seed' (migration day17_product_source).
  source        String   @default("seed")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id             Int        @id @default(autoincrement())
  categoryId     Int
  category       Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String
  slug           String
  description    String     @default("")
  price          Int        // giá gốc, VND
  salePrice      Int?       // giá bán khi giảm, null = không giảm
  images         String[]
  tags           String[]   // slug dịp: sinh-nhat, khai-truong, ...
  isFastDelivery Boolean    @default(false)
  isActive       Boolean    @default(true)
  sku            String?    @unique // mã sản phẩm hiển thị, ví dụ HT-001
  inStock        Boolean    @default(true) // false = tạm hết hàng (vẫn hiển thị, không cho mua)
  sortOrder      Int        @default(0)
  // SEO riêng (Ngày 14 D1): rỗng = dùng tên/mô tả mặc định như trước.
  seoTitle       String     @default("")
  seoDescription String     @default("")
  // Nguồn dữ liệu (Ngày 17 P1): như Category.source.
  source         String     @default("seed")
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId, isActive, sortOrder])
  @@map("products")
}

model Cart {
  id        String     @id @default(cuid())
  token     String     @unique   // chuỗi ngẫu nhiên do ứng dụng sinh, lưu trong cookie
  status    CartStatus @default(ACTIVE)
  items     CartItem[]
  order     Order?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  expiresAt DateTime

  @@index([status, expiresAt])
  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@map("cart_items")
}

model ShippingZone {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  fee       Int      // VND
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  @@map("shipping_zones")
}

model Order {
  id             Int           @id @default(autoincrement())
  code           String        @unique
  cartId         String?       @unique
  cart           Cart?         @relation(fields: [cartId], references: [id], onDelete: SetNull)
  senderName     String
  senderPhone    String
  senderEmail    String?
  receiverName   String
  receiverPhone  String
  address        String
  area           String        // tên khu vực giao tại thời điểm đặt
  deliveryDate   DateTime      @db.Date
  deliverySlot   String
  cardMessage    String?
  note           String?
  subtotal       Int
  shippingFee    Int
  deliveryMethod DeliveryMethod @default(SCHEDULED)
  deliverySurcharge Int         @default(0) // phụ phí của phương thức giao, VND
  total          Int
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus @default(UNPAID)
  paidAt         DateTime? // lúc đánh dấu đã thanh toán (Ngày 8)
  internalNote   String? // ghi chú nội bộ của quản trị (Ngày 8, ≤ 500 ký tự)
  status         OrderStatus   @default(NEW)
  notifiedAt     DateTime?     // đã gửi báo Telegram lúc nào (null = chưa)
  items          OrderItem[]
  events         OrderEvent[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([senderPhone, createdAt])
  @@map("orders")
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String   // bản chụp tại thời điểm đặt
  price     Int      // giá đơn vị đã chốt (VND)
  quantity  Int
  image     String?

  @@map("order_items")
}

// Nhật ký thay đổi đơn hàng (Ngày 8): mỗi lần đổi trạng thái, đánh
// dấu thanh toán, gửi lại thông báo Telegram ghi một dòng. Chi tiết
// đơn hiển thị dòng thời gian (mới nhất trên cùng). Không lưu IP.
enum OrderEventType {
  STATUS_CHANGE
  PAYMENT
  NOTIFY
}

model OrderEvent {
  id         Int            @id @default(autoincrement())
  orderId    Int
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type       OrderEventType
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  note       String?
  createdAt  DateTime       @default(now())

  @@index([orderId, createdAt])
  @@map("order_events")
}

// Phiên đăng nhập quản trị (Ngày 7). Chỉ lưu hash sha256 của token,
// không bao giờ lưu token gốc. Hết hạn tuyệt đối 12 giờ.
model AdminSession {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  @@map("admin_sessions")
}

// Trang tĩnh & chính sách (Ngày 13 B1): nội dung do chủ shop nhập
// trong quản trị, render bằng Markdown an toàn (xem src/lib/markdown.ts).
// Chỉ trang isPublished mới hiện ra shop; seed 3 trang mẫu ở trạng
// thái nháp (chưa xuất bản). Rollback: DROP TABLE "pages".
model Page {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  title          String
  content        String   @default("")
  isPublished    Boolean  @default(false)
  seoTitle       String   @default("")
  seoDescription String   @default("")
  sortOrder      Int      @default(0)
  showInFooter   Boolean  @default(false)
  // Đường dẫn cũ được trang này thay thế (Ngày 14 C1): chỉ một trang
  // được giữ một legacyPath; chỉ có hiệu lực khi trang đã xuất bản.
  // NULL = không thay trang cũ nào.
  legacyPath     String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("pages")
}

// Cài đặt shop (Ngày 11 B2): bảng key-value, một dòng một khóa.
// Giá trị lưu dạng text (chuỗi thường; mảng/khối lưu JSON nếu cần).
// Mặc định KHÔNG nằm ở DB mà ở src/lib/settings.ts — DB trống vẫn
// hiển thị đúng chữ hiện nay; seed chỉ ghi mặc định khi bảng trống.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?

  @@map("site_settings")
}

// Nhật ký thay đổi cài đặt (Ngày 11 B3): khóa, giá trị cũ/mới, ai,
// lúc nào. Không lưu giá trị cũ của khóa nhạy cảm (Ngày 11 chưa có
// khóa nhạy cảm nào).
model SettingsAudit {
  id        Int      @id @default(autoincrement())
  key       String
  oldValue  String?
  newValue  String?
  updatedBy String?
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
  @@map("settings_audit")
}

// Lần đăng nhập quản trị sai (Ngày 7): chỉ lưu hash sha256 của IP,
// không lưu IP thô. Dùng cho giới hạn 5 lần/15 phút theo IP và
// 20 lần/15 phút toàn hệ thống.
model AdminLoginAttempt {
  id        Int      @id @default(autoincrement())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@map("admin_login_attempts")
}

// Tin tức (Ngày 18): quản lý trong admin, chỉ bài isPublished mới
// hiện ra shop (/tin-tuc, /tin-tuc/[slug]). Không seed bài nào —
// bảng bắt đầu trống, trạng thái trống hiển thị "Chưa có tin tức nào".
// publishedAt đặt = now khi xuất bản lần đầu mà đang null; ngày đăng
// hiển thị = publishedAt ?? createdAt. Rollback: DROP TABLE "news".
model NewsArticle {
  id             Int       @id @default(autoincrement())
  slug           String    @unique
  title          String
  excerpt        String    @default("")
  content        String    @default("")
  coverImage     String    @default("")
  author         String    @default("")
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  seoTitle       String    @default("")
  seoDescription String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@map("news")
}

// Sự kiện dùng cho giới hạn tốc độ dùng chung (Ngày 17 S9): một
// hàng = một lần dùng của một khóa (vd "login:ip:<hash>",
// "order:ip:<hash>", "lookup:ip:<hash>", "search:ip:<hash>").
// Cửa sổ trượt đếm số hàng trong khoảng [now - window, now]; hàng
// cũ được dọn định kỳ (pruneRateLimitEvents). Không lưu IP thô,
// chỉ khóa đã băm/chuẩn hóa ở tầng gọi (xem src/lib/rate-limit.ts).
model RateLimitEvent {
  id        Int      @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_events")
}
