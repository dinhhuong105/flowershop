# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.
# Mật khẩu chỉ dùng chữ và số (tránh ký tự đặc biệt làm hỏng DATABASE_URL).

POSTGRES_USER=hoa
POSTGRES_PASSWORD=doi_mat_khau_nay_123
POSTGRES_DB=hoa_shop

# Cổng mở ra máy chủ (chỉ gắn vào 127.0.0.1 với DB)
APP_PORT=3000
DB_PORT=5432

SITE_URL=http://localhost:3000
SHOP_NAME=Hoa Tươi Demo

HOTLINE=0900000000
ZALO_PHONE=0900000000
SHOP_ADDRESS=Địa chỉ cửa hàng (cập nhật sau)
OPEN_HOURS=Thứ 2 – Chủ nhật: 7:30 – 21:00

# Quản trị (Ngày 7): đăng nhập bằng tài khoản + mật khẩu.
# ADMIN_USERNAME mặc định là "admin" khi không đặt.
# ADMIN_PASSWORD_HASH dạng scrypt$<saltHex>$<hashHex> — tạo bằng:
#   echo -n '<mật khẩu>' | npx tsx scripts/hash-admin-password.ts
# KHÔNG ghi mật khẩu gốc hay hash thật vào file này hay commit.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=scrypt$<saltHex>$<hashHex>

# Các biến sau dùng ở ngày sau, chưa cần điền
# SESSION_SECRET=

# Telegram báo đơn (Ngày 5): tạo bot qua @BotFather (/newbot) lấy token,
# nhắn cho bot rồi lấy chat.id qua https://api.telegram.org/bot<token>/getUpdates.
# Thiếu hai biến này thì đơn vẫn tạo bình thường, chỉ không gửi báo.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_API_BASE=https://api.telegram.org (chỉ dùng khi test với máy chủ giả)

# Ngân hàng nhận chuyển khoản (Ngày 5): thiếu thì ẩn lựa chọn "Chuyển khoản".
# Tên hiển thị lấy từ BIN theo bảng trong src/lib/bank.ts (K-9):
# 970436 = Vietcombank, 970415 = VietinBank. BANK_NAME chỉ là dự phòng
# cho BIN chưa có trong bảng.
# BANK_BIN=970436
# BANK_NAME=Vietcombank
# BANK_ACCOUNT=
# BANK_ACCOUNT_NAME= (tên chủ tài khoản, VIẾT HOA KHÔNG DẤU)
